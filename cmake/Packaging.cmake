# CLI-only archive distribution. This does not install the public C++ SDK.
include(GNUInstallDirs)
foreach(dependency IN ITEMS Ciallang fmt::fmt ${CIAL_UTF8PROC_TARGET})
    get_target_property(dependency_type ${dependency} TYPE)
    if(NOT dependency_type STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR "CLI archives require static libraries: ${dependency} is ${dependency_type}")
    endif()
endforeach()
if(CIAL_ENABLE_JIT)
    get_target_property(asmjit_type asmjit::asmjit TYPE)
    if(NOT asmjit_type STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR "CLI archives require static asmjit")
    endif()
endif()
if(WIN32 AND (NOT CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "^MultiThreaded" OR
              CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "DLL"))
    message(FATAL_ERROR "Windows CLI archives require the static CRT (MultiThreaded)")
endif()

set(CIAL_LICENSE_SHARE_DIR "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share"
    CACHE PATH "Dependency share directory containing <port>/copyright")
install(CODE [[
    if(NOT CMAKE_INSTALL_CONFIG_NAME STREQUAL "Release")
        message(FATAL_ERROR "CLI archives must use Release configuration")
    endif()
]] COMPONENT Runtime)

set(cial_license_ports fmt frozen utf8proc argparse)
if(CIAL_ENABLE_JIT)
    list(APPEND cial_license_ports asmjit)
endif()
foreach(port IN LISTS cial_license_ports)
    if(NOT EXISTS "${CIAL_LICENSE_SHARE_DIR}/${port}/copyright")
        message(FATAL_ERROR "Missing ${port} license; set CIAL_LICENSE_SHARE_DIR to the dependency share directory")
    endif()
    install(FILES "${CIAL_LICENSE_SHARE_DIR}/${port}/copyright"
        DESTINATION "licenses/${port}" COMPONENT Runtime)
    if(EXISTS "${CIAL_LICENSE_SHARE_DIR}/${port}/vcpkg.spdx.json")
        install(FILES "${CIAL_LICENSE_SHARE_DIR}/${port}/vcpkg.spdx.json"
            DESTINATION "licenses/${port}" COMPONENT Runtime)
    endif()
endforeach()

set(CIAL_PACKAGE_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    set(CIAL_PACKAGE_ARCH "${CMAKE_OSX_ARCHITECTURES}")
endif()
if(CIAL_PACKAGE_ARCH MATCHES "^(AMD64|amd64|x86_64|x64)$")
    set(CIAL_PACKAGE_ARCH x64)
elseif(CIAL_PACKAGE_ARCH MATCHES "^(aarch64|arm64|ARM64)$")
    set(CIAL_PACKAGE_ARCH arm64)
elseif(CIAL_PACKAGE_ARCH MATCHES ";")
    message(FATAL_ERROR "Universal archives are not yet supported; build one architecture at a time")
endif()
string(TOLOWER "${CMAKE_SYSTEM_NAME}" cial_package_system)
if(APPLE)
    set(cial_package_system macos)
endif()
set(CIAL_PACKAGE_NAME "ciallang-${CIAL_VERSION_STRING}-${cial_package_system}-${CIAL_PACKAGE_ARCH}")

set(cial_revision unknown)
set(cial_dirty unknown)
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${PROJECT_SOURCE_DIR}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
        WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" OUTPUT_VARIABLE cial_revision OUTPUT_STRIP_TRAILING_WHITESPACE
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain
        WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" OUTPUT_VARIABLE cial_status COMMAND_ERROR_IS_FATAL ANY)
    if(cial_status)
        set(cial_dirty true)
    else()
        set(cial_dirty false)
    endif()
endif()
set(cial_build_json "{\n  \"schema_version\": 1")
function(cial_info_field key value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set(cial_build_json "${cial_build_json},\n  \"${key}\": \"${escaped}\"" PARENT_SCOPE)
endfunction()
cial_info_field(version "${CIAL_VERSION_STRING}")
cial_info_field(package_name "${CIAL_PACKAGE_NAME}")
cial_info_field(revision "${cial_revision}")
cial_info_field(dirty "${cial_dirty}")
cial_info_field(system "${CMAKE_SYSTEM_NAME}")
cial_info_field(system_version "${CMAKE_SYSTEM_VERSION}")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    cmake_host_system_information(RESULT cial_distribution QUERY DISTRIB_PRETTY_NAME)
    cial_info_field(distribution "${cial_distribution}")
    execute_process(COMMAND getconf GNU_LIBC_VERSION OUTPUT_VARIABLE cial_libc
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    cial_info_field(libc "${cial_libc}")
endif()
cial_info_field(architecture "${CIAL_PACKAGE_ARCH}")
cial_info_field(configuration "$<CONFIG>")
cial_info_field(compiler "${CMAKE_CXX_COMPILER_ID}")
cial_info_field(compiler_version "${CMAKE_CXX_COMPILER_VERSION}")
cial_info_field(cxx_flags "${CMAKE_CXX_FLAGS}")
cial_info_field(release_flags "${CMAKE_CXX_FLAGS_RELEASE}")
cial_info_field(jit "${CIAL_ENABLE_JIT}")
cial_info_field(msvc_runtime "${CMAKE_MSVC_RUNTIME_LIBRARY}")
cial_info_field(macos_deployment_target "${CMAKE_OSX_DEPLOYMENT_TARGET}")
if(DEFINED ENV{VCPKG_ROOT} AND EXISTS "$ENV{VCPKG_ROOT}/.git" AND GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "$ENV{VCPKG_ROOT}"
        OUTPUT_VARIABLE cial_vcpkg_revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    cial_info_field(vcpkg_revision "${cial_vcpkg_revision}")
endif()
string(APPEND cial_build_json "\n}\n")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/packaging/$<CONFIG>/build-info.json" CONTENT "${cial_build_json}")

install(TARGETS cial RUNTIME DESTINATION bin COMPONENT Runtime)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/packaging/$<CONFIG>/build-info.json" "${PROJECT_SOURCE_DIR}/LICENSE"
    DESTINATION . COMPONENT Runtime)
install(FILES "${PROJECT_SOURCE_DIR}/packaging/README.md" DESTINATION . COMPONENT Runtime)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/packaging/examples/" DESTINATION examples COMPONENT Runtime)

set(CPACK_PACKAGE_NAME ciallang)
set(CPACK_PACKAGE_VERSION "${CIAL_VERSION_STRING}")
set(CPACK_PACKAGE_FILE_NAME "${CIAL_PACKAGE_NAME}")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_INSTALL_CMAKE_PROJECTS "${CMAKE_BINARY_DIR};Ciallang;Runtime;/")
if(WIN32)
    set(CPACK_GENERATOR ZIP)
else()
    set(CPACK_GENERATOR TGZ)
endif()
include(CPack)
