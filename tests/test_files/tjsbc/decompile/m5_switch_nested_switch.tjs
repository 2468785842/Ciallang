// M5: nested switch inside case body stays rejected this batch.
function n(x, y) { var r = 0; switch(x) { case 1: switch(y) { case 1: r += 1; break; case 2: r += 2; break; default: r += 3; break; } r += 100; break; case 2: r += 7; break; } return r; }
println(n(1, 1)); println(n(1, 2)); println(n(1, 9)); println(n(2, 0));
