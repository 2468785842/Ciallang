// M5: reference else-if chain in case body recovered as nested ifs.
function m(x, c) { var r = 0; switch(x) { case 1: if (c == 1) { r += 1; } else if (c == 2) { r += 2; } else { r += 3; } break; case 2: r += 7; break; } return r; }
println(m(1, 1)); println(m(1, 2)); println(m(1, 9)); println(m(2, 0));
