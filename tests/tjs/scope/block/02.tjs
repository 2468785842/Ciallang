// 块作用域 - 遮蔽、重新声明与退出后寄存器复用 / 无初值遮蔽外层，同层重复声明重置为 void
Scripts.execStorage("../../assert.tjs");

function f() {
    var x=5, y=9;
    { var x; if(x!==void) return -1; x=2; }
    var y;
    if(y!==void) return -2;
    var y=3;
    var y=y+4;
    return x*10+y;
}
var __result1 = f();
assertTrue(((int)(__result1)) == 57);

finishTests();
