// 块作用域 - 遮蔽、重新声明与退出后寄存器复用 / while 和 do 块的局部声明不改变外层变量
Scripts.execStorage("../../assert.tjs");

function f() {
    var x=9,total=0,i=0;
    while(i<4) {
        var x=i;
        i++;
        if(x==1) continue;
        total+=x;
    }
    do { var x=7; total+=x; } while(false);
    return x*100+total;
}
var __result1 = f();
assertTrue(((int)(__result1)) == 912);

finishTests();
