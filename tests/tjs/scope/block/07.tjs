// 块作用域 - 遮蔽、重新声明与退出后寄存器复用 / for 初始化有独立作用域，break 和 continue 保留外层变量
Scripts.execStorage("../../assert.tjs");

function f() {
    var i=9,total=0;
    for(var i=0;i<5;i++) {
        if(i==1) continue;
        if(i==4) break;
        total+=i;
    }
    return i*100+total;
}
var __result1 = f();
assertTrue(((int)(__result1)) == 905);

finishTests();
