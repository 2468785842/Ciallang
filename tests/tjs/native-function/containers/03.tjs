// 本地函数声明 - Array/Dictionary 内建方法 / Dictionary assign/clear/erase
Scripts.execStorage("../../assert.tjs");

var d1 = %[a : 1, b : 2];
var d2 = %[];
(Dictionary.assign incontextof d2)(d1);
var c1 = d2.count;
var erased = d2.erase("a");
var c2 = d2.count;
d2.clear();
var c3 = d2.count;
assertTrue(((int)(c1)) == 2);
assertTrue(((int)(erased)) == 1);
assertTrue(((int)(c2)) == 1);
assertTrue(((int)(c3)) == 0);

finishTests();
