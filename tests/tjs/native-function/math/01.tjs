// Math 标准库 / 方法
Scripts.execStorage("../../assert.tjs");

assertTrue((((real)(Math.abs(-3.5)))) == 3.5);
assertTrue((((real)(Math.floor(2.7)))) == 2.0);
assertTrue((((real)(Math.ceil(2.1)))) == 3.0);
assertTrue((((real)(Math.round(2.5)))) == 3.0);
assertTrue((((real)(Math.round(-2.5)))) == -2.0);
assertTrue((((real)(Math.sqrt(16)))) == 4.0);
assertTrue((((real)(Math.pow(2, 10)))) == 1024.0);
assertTrue(((int)(Math.max(1, 5, 3))) == 5);
assertTrue(((int)(Math.min(4, 2))) == 2);
assertTrue((((real)(Math.cos(0)))) == 1.0);
assertTrue(((int)(Math.sin(0))) == 0);

finishTests();
