// Math 标准库 / 原生类构造器（new 编译为透明调用）
Scripts.execStorage("../../assert.tjs");

var re = new RegExp("([0-9]+)-([0-9]+)", "g");
var m = re.exec("a 12-34 b");
var g1 = m[1];
var g2 = m[2];
var re2 = RegExp("[a-z]+", "i");
var t1 = re2.test("ABC");
var a = new Array();
a.push(7);
var ac = a.count;
var av = a[0];
var d = new Dictionary();
d["k"] = 5;
var dc = d.count;
var dv = d["k"];
assertTrue(((int)(g1)) == 12);
assertTrue(((int)(g2)) == 34);
assertTrue(((int)(t1)) == 1);
assertTrue(((int)(ac)) == 1);
assertTrue(((int)(av)) == 7);
assertTrue(((int)(dc)) == 1);
assertTrue(((int)(dv)) == 5);

finishTests();
