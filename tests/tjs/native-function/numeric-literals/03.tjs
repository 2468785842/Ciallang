// 数字字面量——进制/浮点/科学计数法 / 科学计数法（符号可选/整数底数）
Scripts.execStorage("../../assert.tjs");

assertTrue((((real)(1e3))) == 1000.0);
assertTrue((((real)(2E2))) == 200.0);
assertTrue((((real)(1e-3))) == 0.001);
assertTrue((((real)(1e-12 < 1e-11 ? 1e-12 : 0.0))) < 1e-11);
assertTrue((((real)(1.5e-3))) == 0.0015);
assertTrue(((1e-1 + 1) + "") != "");

finishTests();
