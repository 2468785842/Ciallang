// 本地函数声明 - 字符串成员方法定义 / Method - to(Upper|Lower)Case
Scripts.execStorage("../../assert.tjs");

var abc = "AbC"; var __result1 = abc.toUpperCase();
assertTrue((__result1) == "ABC");
var abc = "AbC"; var __result2 = abc.toLowerCase();
assertTrue((__result2) == "abc");
var empty = ""; var __result3 = empty.toUpperCase();
assertTrue((__result3) == "");
var abc = "AbC"; abc.toUpperCase(); var __result4 = abc;
assertTrue((__result4) == "AbC");

finishTests();
