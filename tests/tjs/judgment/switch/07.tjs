// switch - execution / middle break
Scripts.execStorage("../../assert.tjs");

function testSwitch(x) {
    var r;
    switch (x) {
        case 1:
            r = 1;
            break;
            r = 999;
        default:
            r = 0;
    }
    return r;
}
assertTrue(((int)(testSwitch(1))) == 1);
assertTrue(((int)(testSwitch(0))) == 0);

finishTests();
