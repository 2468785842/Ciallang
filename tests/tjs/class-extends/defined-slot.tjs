// TJS2 - 方法字段解析优先使用定义 class 的 slot
Scripts.execStorage("../assert.tjs");

class A {
    var x = 1;
    function A() {}
    function getX() { return x; }
}
class B extends A {
    var x = 2;
    function B() { A(); }
}
var o = new B();
var res = o.getX();
assertTrue(((int)(res)) == 2);

finishTests();
