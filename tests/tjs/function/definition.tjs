// 函数声明 - 简单函数定义
Scripts.execStorage("../assert.tjs");

function empty() { }
function foo() { return 42; }
function add(a, b) { return a + b; }
assertTrue(((empty instanceof "Function")));
assertTrue(((foo instanceof "Function")));
assertTrue(((add instanceof "Function")));
assertTrue((typeof (empty()) == "void"));
assertTrue(((int)(foo())) == 42);
assertTrue(((int)(add(1, 2))) == 3);

finishTests();
