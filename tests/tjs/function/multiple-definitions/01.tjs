// 函数声明 - 多个函数定义 / 多个独立函数
Scripts.execStorage("../../assert.tjs");

function a() { return 1; }
function b() { return 2; }
function c() { return 3; }
var ret = (void);
assertTrue(((a instanceof "Function")));
assertTrue(((b instanceof "Function")));
assertTrue(((c instanceof "Function")));
assertTrue(((int)(a())) == 1);
assertTrue(((int)(b())) == 2);
assertTrue(((int)(c())) == 3);

finishTests();
