{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "ciallang",
  "version-string": "1.0.0",
  "features": {
    "jit": {
      "description": "Optional x64 integer JIT backend",
      "dependencies": [
        "asmjit"
      ]
    },
    "cli": {
      "description": "Command-line application and REPL",
      "dependencies": [
        "argparse"
      ]
    },
    "tests": {
      "description": "Catch2 test suite",
      "dependencies": [
        {
          "name": "catch2",
          "default-features": false
        }
      ]
    }
  },
  "dependencies": [
    "fmt",
    "utf8proc",
    "frozen"
  ]
}
